{
  "name": "biblio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace packages/core run build && npm --workspace apps/web run build",
    "test": "npm run test:core && npm run test:extension",
    "test:core": "node scripts/check-boundaries.mjs && npm --workspace packages/core run test",
    "test:extension": "npm run build:extension && node --test apps/extension/tests/*.test.mjs",
    "test:final": "npm test && npm run typecheck && npm run build && npm run test:e2e",
    "typecheck": "npm --workspace packages/core run build && npm --workspace apps/web run typecheck && npm --workspace apps/site run typecheck",
    "preview": "npm --workspace apps/web run preview",
    "firebase:emulators": "firebase emulators:start --project demo-biblio",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "firebase": "node scripts/firebase.mjs",
    "build:extension": "node scripts/configure-extension.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "site:dev": "npm --workspace apps/site run dev",
    "site:build": "npm --workspace apps/site run build",
    "test:e2e": "playwright test",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "test:extension:live": "npm run build:extension && node apps/extension/tests/live.mjs",
    "update:translators": "node scripts/update-zotero-translators.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "latest",
    "firebase-tools": "^15.32.1",
    "typescript": "5.9.3",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
