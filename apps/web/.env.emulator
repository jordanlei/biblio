# Local test mode (npm run dev:local): Firebase emulators + mock Drive. No real Google account needed.
VITE_USE_EMULATORS=true
VITE_DRIVE_API_BASE=http://127.0.0.1:9199
# A demo project exists only in the emulators; the key is never checked there.
VITE_FIREBASE_PROJECT_ID=demo-bibliograph
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-bibliograph.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:demo
