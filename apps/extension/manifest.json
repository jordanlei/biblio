{
  "manifest_version": 3,
  "name": "Bibliograph",
  "description": "Save the paper you're reading to Bibliograph, PDF included.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Bibliograph"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
