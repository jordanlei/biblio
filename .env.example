# Optional overrides. Normally the app's Firebase settings come from bibliograph.config.json,
# written by `npm run setup` (docs/SELF_HOSTING.md). Any value set here replaces the one there.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
